‎              private fun onSend(text: String) {
‎                  bubble(text, true)
‎
‎                  // ১) ফোন কমান্ড (মডেল ছাড়াই, অফলাইনে)
‎                  val r = phone.handle(text)
‎                  if (r != null) {
‎                      bubble(r, false)
‎                      speakOut(r)
‎                      if (phone.notesChanged) {
‎                          phone.notesChanged = false
‎                          refreshConversation()
‎                      }
‎                      return
‎                  }
‎
‎                  // ২) সাধারণ প্রশ্ন -> মডেল (দরকার হলে ইন্টারনেট থেকে তথ্য নিয়ে)
‎                  if (busy) {
‎                      bubble("একটু অপেক্ষা করুন, আগের কাজ চলছে।", false)
‎                      return
‎                  }
‎                  if (!llm.ready) {
‎                      bubble("মডেল এখনো প্রস্তুত নয়। ফোন কমান্ড কাজ করবে; চ্যাটের জন্য মেনু থেকে মডেল নামান।", false)
‎                      return
‎                  }
‎                  busy = true
‎                  scope.launch {
‎                      try {
‎                          var prompt = text
‎                          if (Web.wantsWeb(text)) {
‎                              if (Web.isOnline(this@MainActivity)) {
‎                                  val note = bubble("🌐 ইন্টারনেটে খুঁজছি...", false)
‎                                  val ctx = withContext(Dispatchers.IO) {
‎                                      try {
‎                                          Web.search(Web.stripPrefix(text).ifBlank { text })
‎                                      } catch (e: Exception) {
‎                                          ""
‎                                      }
‎                                  }
‎                                  chat.removeView(note)
‎                                  if (ctx.isNotBlank()) {
‎                                      prompt = "ইন্টারনেট থেকে পাওয়া তথ্য:\n$ctx\n\nপ্রশ্ন: $text\n" +
‎                                          "উপরের তথ্য ব্যবহার করে সংক্ষেপে উত্তর দাও।"
‎                                  }
‎                              } else {
‎                                  bubble("(ইন্টারনেট নেই, অফলাইন জ্ঞান থেকে বলছি। তথ্য পুরনো হতে পারে)", false)
‎                              }
‎                          }
‎                          val out = bubble("…", false)
‎                          var acc = ""
‎                          try {
‎                              llm.ask(prompt).flowOn(Dispatchers.Default).collect {
‎                                  acc += it
‎                                  out.text = cleanThink(acc)
‎                                  scrollDown()
‎                              }
‎                          } catch (e: Throwable) {
‎                              out.text = "ত্রুটি: ${e.message}"
‎                          }
‎                          speakOut(out.text.toString())
‎                      } finally {
‎                          busy = false
‎                      }
‎                  }
‎              }
