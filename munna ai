‎          package com.personal.ai
‎
‎          import android.content.Context
‎          import com.google.ai.edge.litertlm.Backend
‎          import com.google.ai.edge.litertlm.Contents
‎          import com.google.ai.edge.litertlm.ConversationConfig
‎          import com.google.ai.edge.litertlm.Engine
‎          import com.google.ai.edge.litertlm.EngineConfig
‎          import kotlinx.coroutines.flow.Flow
‎          import kotlinx.coroutines.flow.map
‎          import java.io.File
‎
‎          /** অফলাইন মডেল (LiteRT-LM) সামলায়। */
‎          class Llm(private val ctx: Context) {
‎              private var engine: Engine? = null
‎              private var sender: ((String) -> Flow<String>)? = null
‎              private var pendingSystem: String? = null
‎              private var closer: (() -> Unit)? = null
‎
‎              var backendName: String = ""
‎                  private set
‎
‎              val modelFile: File get() = File(ctx.filesDir, "model.litertlm")
‎              val ready: Boolean get() = sender != null
‎
‎              /** preferred: "GPU" বা "CPU"। প্রথমটা ব্যর্থ হলে অন্যটা চেষ্টা করে। */
‎              fun load(system: String, preferred: String) {
‎                  close()
‎                  val order = if (preferred == "CPU") listOf("CPU", "GPU") else listOf("GPU", "CPU")
‎                  var last: Throwable? = null
‎                  for (name in order) {
‎                      try {
‎                          val backend = if (name == "GPU") Backend.GPU() else Backend.CPU()
‎                          val e = Engine(EngineConfig(modelPath = modelFile.absolutePath, backend = backend))
‎                          try {
‎                              e.initialize()
‎                          } catch (t: Throwable) {
‎                              try { e.close() } catch (_: Throwable) {}
‎                              throw t
‎                          }
‎                          engine = e
‎                          backendName = name
‎                          newConversation(system)
‎                          return
‎                      } catch (t: Throwable) {
‎                          last = t
‎                      }
‎                  }
‎                  throw last ?: IllegalStateException("মডেল লোড হয়নি")
‎              }
‎
‎              fun newConversation(system: String) {
‎                  val e = engine ?: return
‎                  try { closer?.invoke() } catch (_: Throwable) {}
‎                  val conv = e.createConversation()
‎                  pendingSystem = system
‎                  sender = { msg -> conv.sendMessageAsync(msg).map { it.toString() } }
‎                  closer = { conv.close() }
‎              }
‎
‎              fun ask(msg: String): Flow<String> {
‎                  val s = pendingSystem
‎                  pendingSystem = null
‎                  val full = if (s != null) "[নির্দেশনা]\n$s\n\n[ব্যবহারকারীর কথা]\n$msg" else msg
‎                  return sender!!.invoke(full)
‎              }
‎
‎              fun close() {
‎                  try { closer?.invoke() } catch (_: Throwable) {}
‎                  try { engine?.close() } catch (_: Throwable) {}
‎                  closer = null
‎                  sender = null
‎                  engine = null
‎              }
‎          }
